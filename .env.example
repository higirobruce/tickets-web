# Base URL of tickets-backend, read in app/page.js (exposed to the browser)
NEXT_PUBLIC_TICKETS_BCKEND_URL=http://localhost:8081

# Server-side only: how the Next.js server reaches the API. Use this when the public
# hostname is not reachable from the server itself (e.g. http://127.0.0.1:8081).
API_INTERNAL_URL=http://localhost:8081
